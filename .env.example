# Change before publishing or exposing deployment beyond localhost.
POSTGRES_PASSWORD=local_development_only
JWT_SECRET=replace_with_at_least_32_random_characters_before_public_deploy
DEMO_PASSWORD=DemoPass123!
DEMO_TOKEN=change_me_shared_demo_secret
FRONTEND_PORT=8080
PROMETHEUS_PORT=9090
EMBEDDING_BACKEND=e5
# Default v1.8: local ML + validated Prometheus labels for operational decisions.
# Alternatives: context (independent ML), learned (name-only ML), ml (hybrid),
# v2 (expert rules), legacy (original v1.1 rules).
# ML is trained offline during Docker image build; no external AI API required.
CLASSIFIER_ENGINE=context_guarded
# Enable local multilingual E5 neural retrieval in the Docker build (default).
# Set both INSTALL_E5=0 and EMBEDDING_BACKEND=hash to use the lightweight hash fallback.
INSTALL_E5=1
