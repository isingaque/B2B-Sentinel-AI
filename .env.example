# Change before publishing or exposing deployment beyond localhost.
POSTGRES_PASSWORD=local_development_only
JWT_SECRET=replace_with_at_least_32_random_characters_before_public_deploy
DEMO_PASSWORD=DemoPass123!
DEMO_TOKEN=change_me_shared_demo_secret
FRONTEND_PORT=8080
PROMETHEUS_PORT=9090
EMBEDDING_BACKEND=hash
# Optional, experimental external classification (default remains local rules).
AI_PROVIDER=rules
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Or set AI_PROVIDER=openrouter for zero-cost free-model routing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Leave 0 for fast, CPU-only default. Set 1 only when explicitly enabling E5.
INSTALL_E5=0
